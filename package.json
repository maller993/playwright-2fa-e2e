{
  "name": "playwright-2fa-e2e",
  "version": "1.0.0",
  "description": "E2E web con Playwright + TypeScript: login con doble factor por email, validado contra un buzón real (Mailpit)",
  "scripts": {
    "app": "node demo-app/server.js",
